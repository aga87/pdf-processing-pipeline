# Debug configuration
DEBUG=app:scope
DEBUG_COLORS=true

# Google authentication (Service Account JSON as a string)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive folder IDs
PDFS_TO_PROCESS_FOLDER_ID=
PDFS_PROCESSED_FOLDER_ID=
PDFS_DUPLICATES_FOLDER_ID=
PDFS_FAILED_FOLDER_ID=

# Google Cloud project
GCP_PROJECT_ID=

# Cloud Tasks configuration
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_PDF_PROCESSING_QUEUE_NAME=

# Service account used by Cloud Tasks to invoke the worker (OIDC)
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT_EMAIL=

# Worker endpoint that processes the PDF
PDF_PROCESSING_WORKER_URL=
